# Copie este arquivo para ".env" (que não é versionado) e ajuste os valores.

# Chave que assina a sessão e os tokens CSRF dos formulários. Troque por um valor aleatório:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave

# Banco de dados. O padrão é o SQLite em instance/scoutboard.db.
# DATABASE_URL=sqlite:///scoutboard.db

# 1 liga o modo de depuração do Flask (páginas de erro detalhadas). Nunca em produção.
FLASK_DEBUG=0

# Nível do log: DEBUG, INFO, WARNING ou ERROR.
LOG_LEVEL=INFO

# E-mail ou endereço do projeto no User-Agent das consultas à Wikimedia (sobe o limite de requisições).
# SCOUTBOARD_CONTATO=

# 1 liga as fotos que custam uma requisição por jogador (CBF e TheSportsDB).
# SCOUTBOARD_FOTOS_LENTAS=0
